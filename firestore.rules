rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidOrder(data) {
      return data.fullName is string && data.fullName.size() < 500
        && data.mobile is string && data.mobile.size() < 100
        && data.address is map
        && data.total is number
        && data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow read: if false; // Only admin via console for now
    }
  }
}
